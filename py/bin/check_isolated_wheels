# Install each built genkit wheel into its own fresh venv and smoke-test it.
#
# The workspace venv holds every package's dependencies (genkit-django pulls in
# asgiref, for example), which hides a package that forgets to declare one.
# Run after build_dists. Usage: py/bin/check_isolated_wheels [dist_dir]

set -euo pipefail

TOP_DIR=$(git rev-parse --show-toplevel)
DIST_DIR=$(cd "${1:-${TOP_DIR}/py/dist}" && pwd)
PYTHON_VERSION=${PYTHON_VERSION:-3.12}
WORK_DIR=$(mktemp -d)
trap 'rm -rf "${WORK_DIR}"' EXIT

core_wheels=("${DIST_DIR}"/genkit-[0-9]*.whl)
if [[ ! -e "${core_wheels[0]}" ]]; then
  echo "Error: no genkit core wheel in ${DIST_DIR}" >&2
  exit 1
fi

# Package-specific smoke beyond `import <module>`. Must not touch the network.
smoke_script() {
  case "$1" in
  genkit_flask)
    # Flask runs async views only with asgiref (flask[async]).
    cat <<'PY'
from flask import Flask
from genkit import Genkit
from genkit_flask import genkit_flask_handler

ai = Genkit()
app = Flask(__name__)


@app.post('/greet')
@genkit_flask_handler(ai)
@ai.flow()
async def greet(name: str) -> str:
    return f'Hello {name}'


resp = app.test_client().post('/greet', json={'data': 'Ada'})
assert resp.status_code == 200, (resp.status_code, resp.get_data(as_text=True)[:500])
PY
    ;;
  genkit_anthropic)
    # genkit-anthropic forwards these kwargs to messages.create().
    cat <<'PY'
import inspect

from anthropic.resources.messages import AsyncMessages
from genkit_anthropic import AnthropicConfig

missing = AnthropicConfig.CREATE_KWARGS - inspect.signature(AsyncMessages.create).parameters.keys()
assert not missing, f'installed anthropic SDK no longer accepts {sorted(missing)}'
PY
    ;;
  *)
    echo "import $1"
    ;;
  esac
}

failed=()
for wheel in "${DIST_DIR}"/genkit*.whl; do
  module=$(basename "${wheel}" | cut -d- -f1)
  venv="${WORK_DIR}/${module}"
  echo "==> ${module}"
  uv venv --quiet --python "${PYTHON_VERSION}" "${venv}"
  # Pass the local core wheel explicitly so it wins over the same version on PyPI.
  if ! uv pip install --quiet --python "${venv}/bin/python" --find-links "${DIST_DIR}" \
    "${wheel}" "${core_wheels[0]}"; then
    failed+=("${module} (install)")
    continue
  fi
  if ! smoke_script "${module}" | "${venv}/bin/python" -W error::RuntimeWarning -; then
    failed+=("${module} (smoke)")
  fi
done

if ((${#failed[@]})); then
  echo "Isolated wheel check failed:" >&2
  printf '  - %s\n' "${failed[@]}" >&2
  exit 1
fi
echo "All wheels install and import in isolation."
