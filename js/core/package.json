{
  "name": "@genkit-ai/core",
  "description": "Genkit AI framework core libraries.",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc -p tsconfig.test.json",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "genversion -esf src/__codegen/version.ts && rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test tests/*_test.ts",
    "genversion": "genversion -esf src/__codegen/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/core"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/json-schema": "^7.0.15",
    "async-mutex": "^0.5.0",
    "cors": "^2.8.5",
    "dotprompt": "^1.1.1",
    "express": "^4.21.0",
    "get-port": "^5.1.0",
    "json-schema": "^0.4.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "genversion": "^3.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./async": {
      "types": "./lib/async.d.ts",
      "default": "./lib/async.js"
    },
    "./registry": {
      "types": "./lib/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./tracing": {
      "types": "./lib/tracing.d.ts",
      "default": "./lib/tracing.js"
    },
    "./logging": {
      "types": "./lib/logging.d.ts",
      "default": "./lib/logging.js"
    },
    "./schema": {
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "default": "./lib/node.js"
    }
  },
  "typesVersions": {
    "*": {
      "async": [
        "lib/async.d.ts"
      ],
      "registry": [
        "lib/registry.d.ts"
      ],
      "tracing": [
        "lib/tracing.d.ts"
      ],
      "logging": [
        "lib/logging.d.ts"
      ],
      "schema": [
        "lib/schema.d.ts"
      ],
      "node": [
        "lib/node.d.ts"
      ]
    }
  }
}
