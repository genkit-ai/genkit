{
  "name": "@genkit-ai/ai",
  "description": "Genkit AI framework generative AI APIs.",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc -p tsconfig.test.json",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test ./tests/**/*_test.ts ./tests/*_test.ts",
    "test:watch": "node --watch --import tsx --test ./tests/**/*_test.ts ./tests/*_test.ts",
    "test:single": "node --import tsx --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/ai"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@genkit-ai/core": "workspace:*",
    "@types/node": "^22.15.3",
    "colorette": "^2.0.20",
    "dotprompt": "^1.1.1",
    "handlebars": "^4.7.8",
    "json5": "^2.2.3",
    "node-fetch": "^3.3.2",
    "partial-json": "^0.1.7",
    "uri-templates": "^0.2.0",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/uri-templates": "^0.1.34",
    "@types/uuid": "^9.0.6",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./retriever": {
      "types": "./lib/retriever.d.ts",
      "default": "./lib/retriever.js"
    },
    "./embedder": {
      "types": "./lib/embedder.d.ts",
      "default": "./lib/embedder.js"
    },
    "./evaluator": {
      "types": "./lib/evaluator.d.ts",
      "default": "./lib/evaluator.js"
    },
    "./model": {
      "types": "./lib/model.d.ts",
      "default": "./lib/model.js"
    },
    "./model/middleware": {
      "types": "./lib/model/middleware.d.ts",
      "default": "./lib/model/middleware.js"
    },
    "./extract": {
      "types": "./lib/extract.d.ts",
      "default": "./lib/extract.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "default": "./lib/testing/index.js"
    },
    "./reranker": {
      "types": "./lib/reranker.d.ts",
      "default": "./lib/reranker.js"
    },
    "./session": {
      "types": "./lib/session.d.ts",
      "default": "./lib/session.js"
    },
    "./session-stores": {
      "types": "./lib/session-stores.d.ts",
      "default": "./lib/session-stores.js"
    },
    "./agent-core": {
      "types": "./lib/agent-core.d.ts",
      "default": "./lib/agent-core.js"
    },
    "./json-patch": {
      "types": "./lib/json-patch.d.ts",
      "default": "./lib/json-patch.js"
    },
    "./formats": {
      "types": "./lib/formats/index.d.ts",
      "default": "./lib/formats/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "retriever": [
        "lib/retriever.d.ts"
      ],
      "embedder": [
        "lib/embedder.d.ts"
      ],
      "evaluator": [
        "lib/evaluator.d.ts"
      ],
      "model": [
        "lib/model.d.ts"
      ],
      "model/middleware": [
        "lib/model/middleware.d.ts"
      ],
      "extract": [
        "lib/extract.d.ts"
      ],
      "tool": [
        "lib/tool.d.ts"
      ],
      "testing": [
        "lib/testing/index.d.ts"
      ],
      "reranker": [
        "lib/reranker.d.ts"
      ],
      "session": [
        "lib/session.d.ts"
      ],
      "session-stores": [
        "lib/session-stores.d.ts"
      ],
      "agent-core": [
        "lib/agent-core.d.ts"
      ],
      "json-patch": [
        "lib/json-patch.d.ts"
      ],
      "formats": [
        "lib/formats/index.d.ts"
      ]
    }
  }
}
