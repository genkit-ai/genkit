{
  "name": "genkit",
  "description": "Genkit AI framework",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc -p tsconfig.test.json",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test tests/*_test.ts",
    "test:watch": "node --watch --import tsx --test tests/*_test.ts"
  },
  "homepage": "https://genkit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/genkit"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@genkit-ai/ai": "workspace:*",
    "@genkit-ai/core": "workspace:*",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/uuid": "^9.0.6",
    "@valibot/to-json-schema": "^1.8.0",
    "arktype": "^2.2.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "files": [
    "genkit-ui",
    "lib",
    "src",
    "*"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./beta": {
      "types": "./lib/beta.d.ts",
      "default": "./lib/beta.js"
    },
    "./tracing": {
      "types": "./lib/tracing.d.ts",
      "default": "./lib/tracing.js"
    },
    "./logging": {
      "types": "./lib/logging.d.ts",
      "default": "./lib/logging.js"
    },
    "./schema": {
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    },
    "./formats": {
      "types": "./lib/formats.d.ts",
      "default": "./lib/formats.js"
    },
    "./retriever": {
      "types": "./lib/retriever.d.ts",
      "default": "./lib/retriever.js"
    },
    "./reranker": {
      "types": "./lib/reranker.d.ts",
      "default": "./lib/reranker.js"
    },
    "./embedder": {
      "types": "./lib/embedder.d.ts",
      "default": "./lib/embedder.js"
    },
    "./evaluator": {
      "types": "./lib/evaluator.d.ts",
      "default": "./lib/evaluator.js"
    },
    "./model": {
      "types": "./lib/model.d.ts",
      "default": "./lib/model.js"
    },
    "./model/middleware": {
      "types": "./lib/middleware.d.ts",
      "default": "./lib/middleware.js"
    },
    "./extract": {
      "types": "./lib/extract.d.ts",
      "default": "./lib/extract.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./beta/client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./context": {
      "types": "./lib/context.d.ts",
      "default": "./lib/context.js"
    }
  },
  "typesVersions": {
    "*": {
      "registry": [
        "lib/registry.d.ts"
      ],
      "beta": [
        "lib/beta.d.ts"
      ],
      "tracing": [
        "lib/tracing.d.ts"
      ],
      "logging": [
        "lib/logging.d.ts"
      ],
      "schema": [
        "lib/schema.d.ts"
      ],
      "formats": [
        "lib/formats.d.ts"
      ],
      "retriever": [
        "lib/retriever.d.ts"
      ],
      "reranker": [
        "lib/reranker.d.ts"
      ],
      "embedder": [
        "lib/embedder.d.ts"
      ],
      "evaluator": [
        "lib/evaluator.d.ts"
      ],
      "model": [
        "lib/model.d.ts"
      ],
      "model/middleware": [
        "lib/middleware.d.ts"
      ],
      "extract": [
        "lib/extract.d.ts"
      ],
      "testing": [
        "lib/testing.d.ts"
      ],
      "tool": [
        "lib/tool.d.ts"
      ],
      "plugin": [
        "lib/plugin.d.ts"
      ],
      "beta/client": [
        "lib/client/index.d.ts"
      ],
      "context": [
        "lib/context.d.ts"
      ]
    }
  }
}
