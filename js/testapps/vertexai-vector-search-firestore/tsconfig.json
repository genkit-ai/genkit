{
  "compileOnSave": true,
  "include": ["src"],
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "src",
    "module": "nodenext",
    "noImplicitReturns": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "skipLibCheck": true,
    "esModuleInterop": true
  }
}
