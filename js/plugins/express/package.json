{
  "name": "@genkit-ai/express",
  "description": "Genkit AI framework plugin for Express server",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "langchain",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "node --import tsx --test tests/*_test.ts",
    "test:watch": "node --import tsx --watch --test tests/*_test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/express"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "body-parser": "^1.20.3"
  },
  "peerDependencies": {
    "genkit": "workspace:^",
    "express": "^4.21.1 || ^5"
  },
  "devDependencies": {
    "get-port": "^5.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/body-parser": "^1.19.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  }
}
