{
  "name": "@genkit-ai/evaluator",
  "description": "Genkit AI framework plugin for RAG evaluation.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-evaluator",
    "evaluators",
    "google ai",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --config ../../.eslintrc.js --ext .ts src",
    "lint:fix": "npm run lint -- --fix --quiet"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/evaluators"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "compute-cosine-similarity": "^1.1.0",
    "node-fetch": "^3.3.2",
    "dotprompt": "^1.1.1",
    "jsonata": "^2.0.6"
  },
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  }
}
