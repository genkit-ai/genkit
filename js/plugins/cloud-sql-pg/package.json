{
  "name": "genkitx-cloud-sql-pg",
  "description": "Genkit AI framework plugin for Cloud SQL for PostgreSQL.",
  "keywords": [
    "genkit",
    "genkit-retriever",
    "genkit-plugin",
    "genkit-indexer",
    "cloud-sql-connector",
    "cloud-sql-pg",
    "vector",
    "embedding",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/cloud-sql-pg"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.7.1",
    "google-auth-library": "^9.14.2",
    "knex": "^3.1.0",
    "pg": "^8.15.6",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  }
}
