{
  "name": "@genkit-ai/middleware",
  "description": "Middleware for Genkit",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "google cloud",
    "google ai",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "0.12.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsx --test tests/*_test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/middleware"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "devDependencies": {
    "@genkit-ai/google-genai": "workspace:^",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dependencies": {
    "mime-types": "^3.0.2"
  }
}
