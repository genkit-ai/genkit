{
  "name": "genkitx-ollama",
  "description": "Genkit AI framework plugin for Ollama APIs.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-model",
    "ollama",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "commonjs",
  "scripts": {
    "check": "tsc",
    "compile": "tsup-node",
    "build:clean": "rimraf ./lib",
    "build": "pnpm build:clean && pnpm check && pnpm compile",
    "build:watch": "tsup-node --watch",
    "test": "find tests -name '*_test.ts' ! -name '*_live_test.ts' -exec node --import tsx --test {} +",
    "test:live": "node --import tsx --test tests/*_test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/ollama"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "dependencies": {
    "ollama": "^0.5.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ]
}
