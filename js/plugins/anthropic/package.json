{
  "name": "@genkit-ai/anthropic",
  "description": "Genkit AI framework plugin for Anthropic APIs.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-model",
    "anthropic",
    "anthropic-ai",
    "claude-4",
    "haiku-4",
    "opus",
    "haiku",
    "sonnet",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/anthropic"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "check-node-version": "^4.2.1",
    "genkit": "workspace:*",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsx --test tests/*_test.ts",
    "test:file": "tsx --test",
    "test:live": "tsx --test tests/live_test.ts",
    "test:coverage": "check-node-version --node '>=22' && tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' ./tests/**/*_test.ts"
  }
}
