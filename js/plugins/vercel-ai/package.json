{
  "name": "@genkit-ai/vercel-ai",
  "version": "0.7.0",
  "description": "A Genkit plugin providing a Vercel AI SDK ChatTransport for connecting useChat to Genkit Agents.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "vercel",
    "vercel-ai",
    "ai-sdk",
    "useChat",
    "ChatTransport",
    "streaming",
    "agents",
    "ai",
    "genai",
    "generative-ai"
  ],
  "homepage": "https://github.com/genkit-ai/genkit/tree/main/js/plugins/vercel-ai#readme",
  "bugs": {
    "url": "https://github.com/genkit-ai/genkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/vercel-ai"
  },
  "license": "Apache-2.0",
  "author": "genkit",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "lib/client.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsx --test ./tests/*_test.ts"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^3.0.0",
    "ai": "^6.0.0",
    "genkit": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.0",
    "@genkit-ai/express": "workspace:*",
    "ai": "^6.0.192",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "express": "^4.21.1",
    "get-port": "^5.1.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
