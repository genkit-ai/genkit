{
  "name": "@genkit-ai/checks",
  "description": "Google Checks AI Safety plugins for classifying the safety of text against Checks AI safety policies.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "google cloud",
    "google ai",
    "ai",
    "genai",
    "generative-ai",
    "checks",
    "google checks",
    "guardrails"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/checks"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@genkit-ai/ai": "workspace:^",
    "@googleapis/checks": "^4.0.2",
    "google-auth-library": "^9.6.3"
  },
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  }
}
