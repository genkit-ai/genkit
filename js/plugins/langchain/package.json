{
  "name": "genkitx-langchain",
  "description": "Genkit AI framework plugin for langchain.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "langchain",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "commonjs",
  "scripts": {
    "check": "tsc",
    "compile": "tsup-node",
    "build:clean": "rimraf ./lib",
    "build": "pnpm build:clean && pnpm check && pnpm compile",
    "build:watch": "tsup-node --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/langchain"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@langchain/community": "^0.0.53",
    "@langchain/core": "^0.1.61",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependencies": {
    "genkit": "workspace:^",
    "langchain": "^0.1.36"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ]
}
