{
  "name": "@genkit-ai/mcp",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "mcp",
    "model-context-protocol",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "description": "A Genkit plugin that provides interoperability between Genkit and Model Context Protocol (MCP). Both client and server use cases are supported.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsx --test ./tests/*_test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/mcp"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "peerDependencies": {
    "genkit": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "get-port": "^5.1.0",
    "express": "^5.1.0",
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
