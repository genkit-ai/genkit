{
  "name": "@genkit-ai/firebase",
  "description": "Genkit AI framework plugin for Firebase including a Firestore retriever, Firestore session store, durable streaming, auth context and Data Connect tools.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-statestore",
    "genkit-deploy",
    "genkit-flow",
    "firestore",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "firebase emulators:exec 'vitest run' --config tests/emulator/firebase.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/firebase"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "@genkit-ai/google-cloud": "workspace:^"
  },
  "peerDependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "firebase": ">=11.5.0",
    "firebase-admin": ">=12.2",
    "genkit": "workspace:^"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "firebase": "^11.5.0",
    "firebase-tools": "^13.13.2",
    "genkit": "workspace:*",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./beta/data-connect": {
      "types": "./lib/beta/data-connect.d.ts",
      "default": "./lib/beta/data-connect.js"
    },
    "./beta": {
      "types": "./lib/beta.d.ts",
      "default": "./lib/beta.js"
    },
    "./context": {
      "types": "./lib/context.d.ts",
      "default": "./lib/context.js"
    }
  },
  "typesVersions": {
    "*": {
      "beta/data-connect": [
        "lib/beta/data-connect.d.ts"
      ],
      "beta": [
        "lib/beta.d.ts"
      ],
      "context": [
        "lib/context.d.ts"
      ]
    }
  }
}
