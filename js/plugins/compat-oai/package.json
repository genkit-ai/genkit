{
  "name": "@genkit-ai/compat-oai",
  "description": "Genkit AI framework plugin for OpenAI APIs.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-embedder",
    "genkit-model",
    "openai",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/compat-oai"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "openai": "^4.95.0"
  },
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^7.0.2",
    "rimraf": "^6.0.1",
    "vitest": "^4.1.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./openai": {
      "types": "./lib/openai/index.d.ts",
      "default": "./lib/openai/index.js"
    },
    "./deepseek": {
      "types": "./lib/deepseek/index.d.ts",
      "default": "./lib/deepseek/index.js"
    },
    "./xai": {
      "types": "./lib/xai/index.d.ts",
      "default": "./lib/xai/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "openai": [
        "lib/openai/index.d.ts"
      ],
      "deepseek": [
        "lib/deepseek/index.d.ts"
      ],
      "xai": [
        "lib/xai/index.d.ts"
      ]
    }
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run"
  }
}
