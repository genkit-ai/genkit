{
  "name": "@genkit-ai/google-genai",
  "description": "Genkit AI framework plugin for Google AI & Vertex APIs, including Gemini APIs.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-embedder",
    "genkit-model",
    "gemini",
    "google gemini",
    "google ai",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.44.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc",
    "build:clean": "rimraf ./lib",
    "build": "rimraf ./lib && tsc",
    "build:watch": "tsc --watch",
    "test": "tsx --test ./tests/**/*_test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/google-genai"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "dependencies": {
    "google-auth-library": "^9.14.2",
    "jsonpath-plus": "^10.3.0"
  },
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "devDependencies": {
    "@types/jsonpath-plus": "^5.0.5",
    "@types/node": "^22.15.3",
    "@types/sinon": "^17.0.4",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  }
}
