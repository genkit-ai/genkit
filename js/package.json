{
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm build:libs",
    "build:all": "pnpm build:libs && pnpm build:docsnippets && pnpm build:testapps",
    "build:libs": "pnpm -r --workspace-concurrency -1 -F core -F ai -F genkit -F \"./plugins/**\" build",
    "build:core": "pnpm -r -F core -F ai build",
    "build:genkit": "pnpm -F genkit build",
    "build:noncore": "pnpm -r --workspace-concurrency -1 -F \"./plugins/**\" build",
    "build:testapps": "pnpm -r --workspace-concurrency -1 -F \"./testapps/**\" build",
    "build:docsnippets": "pnpm -F doc-snippets build",
    "pack:all": "(mkdir ../dist || true) && pnpm pack:core && pnpm pack:ai && pnpm pack:genkit && pnpm pack:plugins",
    "pack:core": "cd core && pnpm pack --pack-destination ../../dist",
    "pack:ai": "cd ai && pnpm pack --pack-destination ../../dist",
    "pack:genkit": "cd genkit && pnpm pack --pack-destination ../../dist",
    "pack:plugins": "for i in plugins/*/; do cd $i && pnpm pack --pack-destination ../../../dist && cd ../..; done",
    "test:all": "pnpm -r --workspace-concurrency -1 -F \"./(ai|core|plugins|genkit)/**\" test && pnpm test:esm && pnpm test:testing-sample",
    "test:esm": "cd testapps/esm && pnpm test",
    "test:testing-sample": "cd testapps/testing-sample && pnpm test && pnpm test:vitest",
    "gendocs": "pnpm build && pnpm typedoc",
    "typedoc-html": "typedoc --sortEntryPoints false --options typedoc.json"
  },
  "devDependencies": {
    "only-allow": "^1.2.1",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.17",
    "typedoc-github-theme": "^0.4.0",
    "typedoc-plugin-markdown": "^4.10.0",
    "typedoc-plugin-zod": "^1.4.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "cross-spawn": "^7.0.5",
      "undici": "^7.30.0"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "msw",
      "protobufjs",
      "re2",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
