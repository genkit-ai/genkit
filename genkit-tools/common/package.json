{
  "name": "@genkit-ai/tools-common",
  "version": "1.45.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "compile": "pnpm genversion && tsc",
    "typecheck": "pnpm genversion && tsc --noEmit -p tsconfig.test.json",
    "build:clean": "rimraf ./lib",
    "build": "pnpm run build:clean && pnpm run compile",
    "test": "vitest run",
    "build:watch": "pnpm genversion && tsc --watch",
    "genversion": "genversion -esf --property name,version src/utils/version.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@inquirer/prompts": "^8.7.5",
    "@trpc/server": "^11.19.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "catalog:",
    "chokidar": "^5.0.0",
    "colorette": "catalog:",
    "configstore": "^7.0.0",
    "cors": "catalog:",
    "express": "catalog:",
    "get-port": "catalog:",
    "json-2-csv": "^5.6.0",
    "json-schema": "catalog:",
    "terminate": "^2.8.0",
    "ws": "^8.22.0",
    "yaml": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/json-schema": "^7.0.15",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "genversion": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "genkit-tools/common"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "files": [
    "lib/"
  ],
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js",
      "default": "./lib/types/index.js"
    },
    "./eval": {
      "types": "./lib/eval/index.d.ts",
      "import": "./lib/eval/index.js",
      "default": "./lib/eval/index.js"
    },
    "./plugin": {
      "types": "./lib/plugin/index.d.ts",
      "import": "./lib/plugin/index.js",
      "default": "./lib/plugin/index.js"
    },
    "./manager": {
      "types": "./lib/manager/index.d.ts",
      "import": "./lib/manager/index.js",
      "default": "./lib/manager/index.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "import": "./lib/server/index.js",
      "default": "./lib/server/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./lib/utils/index.js",
      "default": "./lib/utils/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "eval": [
        "lib/eval"
      ],
      "plugin": [
        "lib/plugin"
      ],
      "manager": [
        "lib/manager"
      ],
      "server": [
        "lib/server"
      ],
      "utils": [
        "lib/utils"
      ]
    }
  }
}
