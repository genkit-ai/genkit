{
  "name": "@genkit-ai/tools-common",
  "version": "1.45.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "compile": "pnpm genversion && tsc",
    "build:clean": "rimraf ./lib",
    "build": "pnpm run build:clean && pnpm run compile",
    "test": "vitest run",
    "build:watch": "pnpm genversion && tsc --watch",
    "genversion": "genversion -esf --property name,version src/utils/version.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@inquirer/prompts": "^8.7.3",
    "@trpc/server": "^11.19.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.20.0",
    "chokidar": "^5.0.0",
    "colorette": "^2.0.20",
    "configstore": "^7.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "get-port": "^7.2.0",
    "json-2-csv": "^5.6.0",
    "json-schema": "^0.4.0",
    "terminate": "^2.8.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "3.25.67",
    "zod-to-json-schema": "~3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "dotprompt": "1.1.2",
    "genversion": "^3.2.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "genkit-tools/common"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "files": [
    "lib/"
  ],
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js",
      "default": "./lib/types/index.js"
    },
    "./eval": {
      "types": "./lib/eval/index.d.ts",
      "import": "./lib/eval/index.js",
      "default": "./lib/eval/index.js"
    },
    "./plugin": {
      "types": "./lib/plugin/index.d.ts",
      "import": "./lib/plugin/index.js",
      "default": "./lib/plugin/index.js"
    },
    "./manager": {
      "types": "./lib/manager/index.d.ts",
      "import": "./lib/manager/index.js",
      "default": "./lib/manager/index.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "import": "./lib/server/index.js",
      "default": "./lib/server/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./lib/utils/index.js",
      "default": "./lib/utils/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "eval": [
        "lib/eval"
      ],
      "plugin": [
        "lib/plugin"
      ],
      "manager": [
        "lib/manager"
      ],
      "server": [
        "lib/server"
      ],
      "utils": [
        "lib/utils"
      ]
    }
  }
}
