{
  "name": "genkit-cli",
  "version": "1.45.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "CLI for interacting with the Google Genkit AI framework",
  "license": "Apache-2.0",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "author": "genkit",
  "bin": {
    "genkit": "dist/bin/genkit.js"
  },
  "files": [
    "dist/"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm genversion && tsc",
    "build:watch": "tsc --watch",
    "compile:bun": "bun build src/bin/genkit.ts --compile --outfile dist/bin/genkit --minify",
    "test": "vitest run",
    "genversion": "genversion -esf --property name,version src/utils/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "genkit-tools/cli"
  },
  "dependencies": {
    "@genkit-ai/telemetry-server": "workspace:*",
    "@genkit-ai/tools-common": "workspace:*",
    "@inquirer/prompts": "^7.10.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "colorette": "^2.0.20",
    "commander": "^14.0.3",
    "get-port": "5.1.1",
    "open": "^6.4.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/semver": "^7.8.0",
    "bun-types": "^1.4.3",
    "genversion": "^3.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
