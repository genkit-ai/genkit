{
  "name": "genkit-cli",
  "version": "1.45.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "CLI for interacting with the Google Genkit AI framework",
  "license": "Apache-2.0",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "author": "genkit",
  "bin": {
    "genkit": "dist/bin/genkit.js"
  },
  "files": [
    "dist/"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm genversion && tsc",
    "typecheck": "pnpm genversion && tsc --noEmit -p tsconfig.test.json",
    "build:watch": "tsc --watch",
    "compile:bun": "bun build src/bin/genkit.ts --compile --outfile dist/bin/genkit --minify",
    "test": "vitest run",
    "genversion": "genversion -esf --property name,version src/utils/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "genkit-tools/cli"
  },
  "dependencies": {
    "@genkit-ai/telemetry-server": "workspace:*",
    "@genkit-ai/tools-common": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "catalog:",
    "colorette": "catalog:",
    "commander": "^14.0.3",
    "get-port": "catalog:",
    "open": "^11.0.4",
    "semver": "^7.8.6",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "bun-types": "^1.4.4",
    "genversion": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
