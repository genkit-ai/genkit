{
  "name": "@genkit-ai/telemetry-server",
  "description": "Genkit AI telemetry server",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.45.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "compile": "pnpm genversion && tsc",
    "typecheck": "pnpm genversion && tsc --noEmit -p tsconfig.test.json",
    "build:clean": "rimraf ./lib",
    "build": "pnpm run build:clean && pnpm run compile",
    "test": "vitest run",
    "build:watch": "pnpm genversion && tsc --watch",
    "genversion": "genversion -esf src/utils/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "genkit-tools/telemetry-server"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "files": [
    "lib/"
  ],
  "dependencies": {
    "@genkit-ai/tools-common": "workspace:*",
    "async-mutex": "^0.5.0",
    "cors": "catalog:",
    "express": "catalog:",
    "lockfile": "^1.0.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/lockfile": "^1.0.4",
    "@types/node": "catalog:",
    "genversion": "catalog:",
    "get-port": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  }
}
