{
  "name": "@genkit-ai/telemetry-server",
  "description": "Genkit AI telemetry server",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "1.45.0",
  "type": "commonjs",
  "scripts": {
    "compile": "pnpm genversion && tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json",
    "build:clean": "rimraf ./lib",
    "build": "pnpm run build:clean && pnpm run compile",
    "test": "node --import tsx --test tests/*_test.ts",
    "build:watch": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json --watch",
    "genversion": "genversion -esf src/utils/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "genkit-tools/telemetry-server"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "files": [
    "lib/"
  ],
  "dependencies": {
    "@genkit-ai/tools-common": "workspace:*",
    "async-mutex": "^0.5.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lockfile": "^1.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lockfile": "^1.0.4",
    "@types/node": "^26.6.6",
    "genversion": "^3.2.0",
    "get-port": "^7.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/cjs/index.js",
      "import": "./lib/esm/index.js",
      "types": "./lib/types/index.d.ts",
      "default": "./lib/esm/index.js"
    }
  }
}
