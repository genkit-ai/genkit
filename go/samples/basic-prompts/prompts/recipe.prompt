---
model: googleai/gemini-flash-latest
config:
  thinkingConfig:
    thinkingLevel: MEDIUM
input:
  schema: RecipeRequest
output:
  format: json
  schema: Recipe
---
{{role "system"}}
{{> chefPersona}}

{{role "user"}}
Create a {{cuisine}} {{dish}} recipe for {{servingSize}} people that takes under {{maxPrepMinutes}} minutes to prepare.
