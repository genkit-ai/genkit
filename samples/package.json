{
  "name": "genkit-samples",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:js-angular": "pnpm -r -F \"./js-angular/*\" build",
    "build:js-character-generator": "pnpm -F ./js-character-generator build",
    "build:js-chatbot": "pnpm -r -F \"./js-chatbot/*\" build",
    "build:js-coffee-shop": "pnpm -F ./js-coffee-shop build",
    "build:js-gemini": "pnpm -F ./js-gemini build",
    "build:js-menu": "pnpm -F ./js-menu build",
    "build:js-openai": "pnpm -F ./js-openai build",
    "build:js-prompts": "pnpm -F ./js-prompts build",
    "build:js-schoolAgent": "pnpm -F ./js-schoolAgent build",
    "build:all-samples": "pnpm -r --workspace-concurrency -1 -F \"./js-*\" -F \"!./js-angular\" -F \"!./js-chatbot\" -F \"./js-angular/*\" -F \"./js-chatbot/*\" build"
  },
  "devDependencies": {
    "only-allow": "^1.2.1",
    "prettier": "^3.2.5",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.30.0"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "protobufjs",
      "re2",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
